[Unit]
Description=PriceReminder Binance relay and iOS background monitor
After=network-online.target docker.service mihomo.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=pricereminder
Group=pricereminder
EnvironmentFile=/etc/pricereminder.env
ExecStart=/opt/pricereminder/pricereminder
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
